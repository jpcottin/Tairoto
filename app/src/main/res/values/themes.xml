<resources>
    <!-- The window behind the Vulkan surface: deep water, so nothing flashes white on launch. -->
    <style name="Theme.Tairoto" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/deep_water</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <color name="deep_water">#FF06232B</color>
    <color name="icon_background">#FF0B3C47</color>
</resources>
